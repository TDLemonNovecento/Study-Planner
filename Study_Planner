# 1. SETUP & LIBRARIES ----
# Load all required packages here
library(ggplot2)
library(dplyr)
library(readr)
library(stringr)
library(pdftools)
library(tidyr)
library(shiny)
library(DT)

# Set working directory or paths if needed
setwd(".")
path_studyplan <- "masmtec-studyplan-2026-2028.pdf"

# 2. LOAD DATA ----
# Read raw data from files or databases
PDF <- pdftools::pdf_text(path_studyplan) %>% readr::read_lines() 
# Regex using large gaps (minimum 3 spaces) as column separators
regex_pattern <- paste0(
  "^([0-9]{3}-[0-9]{4}-[0-9]{2})\\s+",
  "(.+?)\\s{3,}",             # title
  "([0-9/,.]+)\\s{3,}",        # semester
  "([0-9]+)\\s{3,}",           # credits (allow multiple digits)
  "(.+)$"                      # professors
)
# fix master thesis column so it is recognized correctly
PDF[grepl("D-MTEC professors", PDF)]

pdf_df <- PDF %>%
  tibble::tibble(line = .) %>%
  # move elements that are on top (e.g. headers, categories) into long format (i.e. columns)
  dplyr::mutate(
    ids = stringr::str_split(line, "\\s+") %>%
      purrr::map_chr(~ dplyr::coalesce(.x[2], "")),
    is_lecture = grepl("36", ids),
    is_header = dplyr::lead(is_lecture) == !is_lecture & !is_lecture,
    header = dplyr::if_else(is_header, trimws(line), NA_character_),
    category = dplyr::if_else(grepl("[A-Z]{5,}", line), trimws(sub("\\s{3,}.*$", "", line)), NA_character_)) %>%
  tidyr::fill(header, category) %>%
  dplyr::filter(is_lecture) %>%
  # separate elements in the string into the correct columns
  dplyr::mutate(block = grepl("=", line),
    line = trimws(gsub("=", "", line))) %>%
  tidyr::extract(
    col = line,
    into = c("course_id", "title", "semester", "credits", "professors"),
    regex = regex_pattern,
    remove = FALSE
  ) %>%
  dplyr::mutate(dplyr::across(where(is.character), trimws)) %>%
  dplyr::select(-ids, -is_lecture, -is_header, -line)

tail(pdf_df )

write.csv(pdf_df, file = "TAB_01_digitized_plan.csv", row.names = FALSE)

# 2. COURSE SELECTION ----

# 2.1. Load data
setwd("/Users/miriam/Documents/MAS_MTEC/Programmplanung")
my_data <- read.csv("TAB_01_digitized_plan.csv")

select_elements_app <- function(df) {
  # 2.2. Define the UI
  ui <- fluidPage(
    tags$head(tags$style(HTML("
      html, body {
        height: 100%;
        overflow: hidden;
      }
      .container-fluid {
        height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .row {
        flex: 1;
        min-height: 0;
        display: flex;
      }
      .sidebar {
        overflow-y: auto;
      }
      .main {
        height: 100%;
        overflow-y: auto;
      }
    "))),
    titlePanel("Select Lectures"),
    sidebarLayout(
      sidebarPanel(
        class = "sidebar",
        p("Click rows to select items across categories."),
        br(),
        wellPanel(
          h4("Total Selected Credits:"),
          h3(textOutput("total_credits"),
             style = "color: #2c3e50; font-weight: bold;"),
          hr(),
          h5("Selected Credits by Category:"), 
          DTOutput("credits_by_category"),
          br(),
          h5("Selected Credits by Semester:"), 
          DTOutput("credits_by_semester")
        ),
        br(),
        # Buttons for assigning semesters and marking optional courses
        actionButton("assign_sem_btn", "Assign Semesters", class = "btn-info",
                     style = "color: white; width: 100%; margin-bottom: 8px;"),
        actionButton("mark_optional_btn", "Mark as Optional", class = "btn-warning",
                     style = "color: white; width: 100%; margin-bottom: 10px;"),
        # Save & Close button
        actionButton("save_btn", "Save & Close", class = "btn-success",
                     style = "color: white; width: 100%;")
      ),
      mainPanel(
        class = "main",
        DTOutput("table")
      )
    )
  )
  
  # 2.3. Define the Server logic
  server <- function(input, output, session) {
    
    # Reactive values to store user choices for multi-semester courses and optional flags
    rv <- reactiveValues(
      custom_sems = list(),
      optional_flags = list()
    )
    
    # Render the interactive table with multi-row selection enabled
    output$table <- renderDT({
      datatable(df, selection = 'multiple', options = list(pageLength = 100))
    })
    
    # Reactive helper for selected rows with resolved semester evaluation and optional status
    selected_data_reactive <- reactive({
      selected_rows <- input$table_rows_selected
      if (length(selected_rows) == 0) {
        return(df[0, ])
      }
      
      df %>%
        dplyr::slice(selected_rows) %>%
        dplyr::mutate(
          row_num = selected_rows,
          resolved_semester = purrr::map2_dbl(row_num, semester, function(r, sem) {
            r_str <- as.character(r)
            if (!is.null(rv$custom_sems[[r_str]])) {
              return(rv$custom_sems[[r_str]])
            }
            if (grepl("/", sem)) {
              suppressWarnings(as.numeric(sub("/.*", "", sem)))
            } else {
              suppressWarnings(as.numeric(sem))
            }
          }),
          resolved_optional = purrr::map_lgl(row_num, function(r) {
            r_str <- as.character(r)
            if (!is.null(rv$optional_flags[[r_str]])) {
              return(rv$optional_flags[[r_str]])
            }
            FALSE
          })
        )
    })
    
    # Dynamically calculate the sum of credits for selected rows
 # Dynamically calculate total credits and optional credits
    output$total_credits <- renderText({
      dat <- selected_data_reactive()
      if (nrow(dat) == 0) {
        return("0 (optional: 0)")
      } else {
        mandatory_credits <- sum(dat$credits[!dat$resolved_optional], na.rm = TRUE)
        optional_credits <- sum(dat$credits[dat$resolved_optional], na.rm = TRUE)
        
        paste0(mandatory_credits, " (optional: ", optional_credits, ")")
      }
    })

    # Display credits by category
    output$credits_by_category <- renderDT({
      dat <- selected_data_reactive()
      if (nrow(dat) == 0) {
        summary_df <- data.frame(category = character(), credits = numeric())
      } else {
        summary_df <- dat %>%
          dplyr::group_by(category) %>%
          dplyr::summarise(
            credits = sum(credits, na.rm = TRUE),
            .groups = "drop"
          )
      }
      DT::datatable(summary_df, options = list(dom = "t", paging = FALSE))
    })
    
    # Display credits by semester, split into credits (non-optional) and optional credits
    output$credits_by_semester <- renderDT({
      dat <- selected_data_reactive()
      if (nrow(dat) == 0) {
        summary_df <- data.frame(semester = numeric(), credits = numeric(), optional = numeric())
      } else {
        summary_df <- dat %>%
          dplyr::group_by(semester = resolved_semester) %>%
          dplyr::summarise(
            credits = sum(credits[!resolved_optional], na.rm = TRUE),
            optional = sum(credits[resolved_optional], na.rm = TRUE),
            .groups = "drop"
          ) %>%
          dplyr::arrange(semester)
      }
      DT::datatable(summary_df, options = list(dom = "t", paging = FALSE))
    })
    
    # Trigger pop-up modal when "Assign Semesters" button is clicked
    observeEvent(input$assign_sem_btn, {
      selected_rows <- input$table_rows_selected
      
      if (length(selected_rows) == 0) {
        showNotification("Please select at least one course first.", type = "warning")
        return()
      }
      
      multi_rows <- selected_rows[grepl("/", df$semester[selected_rows])]
      
      if (length(multi_rows) == 0) {
        showNotification("No multi-semester courses found among your selections.", type = "message")
        return()
      }
      
      showModal(modalDialog(
        title = "Assign Semesters for Multi-Semester Courses",
        p("Choose the specific semester for each selected multi-semester course:"),
        lapply(multi_rows, function(r) {
          sems <- as.numeric(unlist(strsplit(df$semester[r], "/")))
          r_str <- as.character(r)
          current_val <- if (!is.null(rv$custom_sems[[r_str]])) rv$custom_sems[[r_str]] else sems[1]
          
          fluidRow(
            column(8, p(strong(df$course_id[r]), ": ", df$title[r])),
            column(4, selectInput(paste0("sem_choice_", r), "Semester", choices = sems, selected = current_val))
          )
        }),
        footer = tagList(
          modalButton("Cancel"),
          actionButton("confirm_sem_btn", "Confirm & Update", class = "btn-primary")
        )
      ))
    })
    
    # Handle confirmation from the semester modal pop-up
    observeEvent(input$confirm_sem_btn, {
      selected_rows <- input$table_rows_selected
      multi_rows <- selected_rows[grepl("/", df$semester[selected_rows])]
      
      for (r in multi_rows) {
        rv$custom_sems[[as.character(r)]] <- as.numeric(input[[paste0("sem_choice_", r)]])
      }
      
      removeModal()
    })
    
    # Trigger pop-up modal when "Mark as Optional" button is clicked
    observeEvent(input$mark_optional_btn, {
      selected_rows <- input$table_rows_selected
      
      if (length(selected_rows) == 0) {
        showNotification("Please select at least one course first.", type = "warning")
        return()
      }
      
      showModal(modalDialog(
        title = "Mark Courses as Optional",
        p("Check the box for any selected courses that should be marked as optional:"),
        lapply(selected_rows, function(r) {
          r_str <- as.character(r)
          current_opt <- if (!is.null(rv$optional_flags[[r_str]])) rv$optional_flags[[r_str]] else FALSE
          
          fluidRow(
            column(8, p(strong(df$course_id[r]), ": ", df$title[r])),
            column(4, checkboxInput(paste0("opt_choice_", r), "Optional", value = current_opt))
          )
        }),
        footer = tagList(
          modalButton("Cancel"),
          actionButton("confirm_opt_btn", "Confirm & Update", class = "btn-primary")
        )
      ))
    })
    
    # Handle confirmation from the optional modal pop-up
    observeEvent(input$confirm_opt_btn, {
      selected_rows <- input$table_rows_selected
      for (r in selected_rows) {
        rv$optional_flags[[as.character(r)]] <- isTRUE(input[[paste0("opt_choice_", r)]])
      }
      removeModal()
    })
    
    # Listen for the final save button click
    observeEvent(input$save_btn, {
      selected_rows <- input$table_rows_selected
      save_final_data(selected_rows)
    })
    
    # Helper function to generate final altered dataset and close app
    save_final_data <- function(selected_rows) {
      if (length(selected_rows) == 0) {
        altered_data <- df %>% dplyr::mutate(selected = NA_real_, optional = FALSE)
        stopApp(altered_data)
        return()
      }
      
      altered_data <- df %>% 
        dplyr::mutate(
          row_num = dplyr::row_number(),
          selected = dplyr::case_when(
            !row_num %in% selected_rows ~ NA_real_,
            grepl("/", semester) ~ purrr::map_dbl(row_num, ~ {
              r_str <- as.character(.x)
              if (!is.null(rv$custom_sems[[r_str]])) {
                rv$custom_sems[[r_str]]
              } else {
                suppressWarnings(as.numeric(sub("/.*", "", semester[.x])))
              }
            }),
            TRUE ~ suppressWarnings(as.numeric(semester))
          ),
          optional = dplyr::case_when(
            !row_num %in% selected_rows ~ FALSE,
            TRUE ~ purrr::map_lgl(row_num, ~ {
              r_str <- as.character(.x)
              if (!is.null(rv$optional_flags[[r_str]])) {
                rv$optional_flags[[r_str]]
              } else {
                FALSE
              }
            })
          )
        ) %>%
        dplyr::select(-row_num)
      
      stopApp(altered_data)
    }
  }
  
  # Run the app locally
  runApp(shinyApp(ui, server))
}


# 2.4 Run it in the console: ---
altered_data <- select_elements_app(my_data)
print(altered_data %>% dplyr::filter(!is.na(selected)))
write.csv(altered_data %>% dplyr::filter(!is.na(selected)), file = "TAB_02_selected_plan.csv", row.names = FALSE)
